{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observed execution record, not a design quality score",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "scenario",
    "command",
    "readOnly",
    "before",
    "after",
    "exitCode"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "observed-execution"
    },
    "scenario": {
      "type": "string"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "readOnly": {
      "type": "boolean"
    },
    "before": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "after": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "exitCode": {
      "type": [
        "integer",
        "null"
      ]
    }
  }
}
