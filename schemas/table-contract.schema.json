{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingmanpm.local/schemas/table-contract.schema.json",
  "title": "WingmanPM data table contract",
  "type": "object",
  "required": [
    "id",
    "version",
    "profile",
    "semantics",
    "rowIdField",
    "pagination",
    "columns",
    "capabilities",
    "interactionAlternatives",
    "preferences",
    "states",
    "evidence"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "profile": { "enum": ["static", "work", "editable"] },
    "semantics": { "enum": ["table", "grid"] },
    "rowIdField": { "type": "string", "minLength": 1 },
    "pagination": {
      "type": "object",
      "required": ["mode", "pageSize"],
      "properties": {
        "mode": { "enum": ["client", "offset", "cursor"] },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 1000 }
      },
      "additionalProperties": false
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/column" }
    },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "interactionAlternatives": { "$ref": "#/$defs/interactionAlternatives" },
    "preferences": { "$ref": "#/$defs/preferences" },
    "states": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "loading",
          "empty",
          "no-results",
          "partial",
          "stale",
          "error",
          "permission",
          "offline",
          "saving",
          "success"
        ]
      },
      "allOf": [
        { "contains": { "const": "loading" } },
        { "contains": { "const": "empty" } },
        { "contains": { "const": "no-results" } },
        { "contains": { "const": "error" } },
        { "contains": { "const": "permission" } },
        { "contains": { "const": "offline" } }
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["stories", "browserTests", "visualReview"],
      "properties": {
        "stories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "browserTests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "visualReview": { "type": "string", "pattern": "\\.json$" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "profile": { "const": "static" } } },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "visibility": { "const": false },
              "reorder": { "const": false },
              "resize": { "const": false },
              "selection": { "const": false },
              "bulkActions": { "const": false },
              "inlineEditing": { "const": false },
              "virtualization": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "profile": { "const": "work" } } },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "visibility": { "const": true },
              "reorder": { "const": true },
              "resize": { "const": true },
              "expansion": { "const": true },
              "selection": { "const": true },
              "bulkActions": { "const": true },
              "inlineEditing": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "profile": { "const": "editable" } } },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "visibility": { "const": true },
              "reorder": { "const": true },
              "resize": { "const": true },
              "expansion": { "const": true },
              "selection": { "const": true },
              "bulkActions": { "const": true },
              "inlineEditing": { "const": true }
            }
          },
          "columns": {
            "contains": { "required": ["editor"] }
          }
        }
      }
    },
    {
      "if": { "properties": { "semantics": { "const": "grid" } } },
      "then": {
        "properties": {
          "interactionAlternatives": {
            "properties": { "gridKeyboard": { "const": "roving-focus" } }
          }
        }
      },
      "else": {
        "properties": {
          "interactionAlternatives": {
            "properties": { "gridKeyboard": { "const": "not-applicable" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": { "properties": { "reorder": { "const": true } } }
        }
      },
      "then": {
        "properties": {
          "interactionAlternatives": {
            "properties": {
              "columnReorder": {
                "allOf": [
                  { "contains": { "const": "drag" } },
                  { "contains": { "const": "move-buttons" } }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": { "properties": { "resize": { "const": true } } }
        }
      },
      "then": {
        "properties": {
          "interactionAlternatives": {
            "properties": {
              "columnResize": {
                "allOf": [
                  { "contains": { "const": "pointer" } },
                  { "contains": { "const": "keyboard-separator" } },
                  { "contains": { "const": "width-presets" } }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "column": {
      "type": "object",
      "required": [
        "id",
        "label",
        "type",
        "align",
        "minWidth",
        "defaultWidth",
        "maxWidth",
        "priority",
        "required",
        "hideable",
        "sortable",
        "filterable",
        "resizable",
        "reorderable",
        "fullValue"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "number", "date", "status", "actions", "selection"] },
        "align": { "enum": ["start", "center", "end"] },
        "minWidth": { "type": "number", "exclusiveMinimum": 0 },
        "defaultWidth": { "type": "number", "exclusiveMinimum": 0 },
        "maxWidth": { "type": "number", "exclusiveMinimum": 0 },
        "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
        "required": { "type": "boolean" },
        "hideable": { "type": "boolean" },
        "sortable": { "type": "boolean" },
        "filterable": { "type": "boolean" },
        "resizable": { "type": "boolean" },
        "reorderable": { "type": "boolean" },
        "fullValue": { "enum": ["wrap", "focus-tooltip", "row-details"] },
        "editor": { "enum": ["text", "number", "select", "date"] }
      },
      "allOf": [
        {
          "if": { "properties": { "required": { "const": true } } },
          "then": { "properties": { "hideable": { "const": false } } }
        }
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "visibility",
        "reorder",
        "resize",
        "expansion",
        "selection",
        "bulkActions",
        "inlineEditing",
        "virtualization"
      ],
      "properties": {
        "visibility": { "type": "boolean" },
        "reorder": { "type": "boolean" },
        "resize": { "type": "boolean" },
        "expansion": { "type": "boolean" },
        "selection": { "type": "boolean" },
        "bulkActions": { "type": "boolean" },
        "inlineEditing": { "type": "boolean" },
        "virtualization": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "interactionAlternatives": {
      "type": "object",
      "required": ["columnReorder", "columnResize", "fullValue", "gridKeyboard"],
      "properties": {
        "columnReorder": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": { "enum": ["drag", "move-buttons"] }
        },
        "columnResize": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": { "enum": ["pointer", "keyboard-separator", "width-presets"] }
        },
        "fullValue": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["wrap", "focus-tooltip", "row-details"] }
        },
        "gridKeyboard": { "enum": ["not-applicable", "roving-focus"] }
      },
      "additionalProperties": false
    },
    "preferences": {
      "type": "object",
      "required": ["scope", "fallback", "schemaVersion", "persist", "neverPersist"],
      "properties": {
        "scope": { "enum": ["account", "workspace", "local"] },
        "fallback": { "enum": ["versioned-local-storage", "none"] },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "persist": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["density", "columnOrder", "columnVisibility", "columnWidths"] }
        },
        "neverPersist": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["selection", "drafts", "errors", "activeEditing"] },
          "allOf": [
            { "contains": { "const": "selection" } },
            { "contains": { "const": "drafts" } },
            { "contains": { "const": "errors" } },
            { "contains": { "const": "activeEditing" } }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
