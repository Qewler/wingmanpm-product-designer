{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wingmanpm.local/schemas/config.schema.json",
  "title": "WingmanPM Product Designer project configuration",
  "type": "object",
  "required": ["schemaVersion", "systemMode", "stack", "requiresDarkTheme", "viewports"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "systemMode": { "enum": ["new-system", "preserve"] },
    "stack": { "type": "string", "minLength": 1 },
    "goldenStack": { "type": "boolean" },
    "requiresDarkTheme": { "type": "boolean" },
    "aiSurfaces": { "type": "boolean" },
    "viewports": {
      "type": "array",
      "items": { "type": "integer", "minimum": 320 },
      "allOf": [
        { "contains": { "const": 390 } },
        { "contains": { "const": 768 } },
        { "contains": { "const": 1280 } },
        { "contains": { "const": 1440 } }
      ]
    },
    "visualEvidenceMaxAgeDays": { "type": "integer", "minimum": 1, "maximum": 180 }
  },
  "additionalProperties": false
}
