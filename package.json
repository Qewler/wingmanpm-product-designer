{
  "name": "wingmanpm-product-designer-private",
  "version": "0.2.0-private.1",
  "private": true,
  "description": "Private development build of the WingmanPM Product Designer Agent Skill.",
  "author": {
    "name": "Julius",
    "url": "https://github.com/Qewler"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qewler/wingmanpm-product-designer.git"
  },
  "homepage": "https://github.com/Qewler/wingmanpm-product-designer#readme",
  "bugs": {
    "url": "https://github.com/Qewler/wingmanpm-product-designer/issues"
  },
  "type": "module",
  "bin": {
    "wingman-design": "./bin/wingman-design.mjs"
  },
  "files": [
    "SKILL.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "agents/",
    "bin/",
    "docs/",
    "references/",
    "registry/",
    "schemas/",
    "src/",
    "templates/"
  ],
  "scripts": {
    "check": "npm run validate:skill && npm test",
    "doctor": "node ./bin/wingman-design.mjs --help",
    "test": "node --test tests/*.test.mjs",
    "test:all": "npm run test && npm run validate:skill && npm run eval:fixtures",
    "test:fixture:storybook": "npm --prefix fixtures/neutral-saas run build-storybook",
    "test:fixture:browser": "npm --prefix fixtures/neutral-saas run design:test:visual",
    "validate:skill": "node ./scripts/validate-skill.mjs .",
    "eval:fixtures": "node ./evals/run-fixture-evals.mjs",
    "eval:codex": "node ./evals/validate-agent-result.mjs ./evals/results/codex.json",
    "check:share": "node ./scripts/check-share-safety.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
