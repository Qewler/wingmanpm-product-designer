{
  "name": "wingmanpm-product-designer",
  "version": "1.1.0",
  "description": "Product design judgment, production UI patterns, and verifiable quality gates for coding agents.",
  "author": {
    "name": "Wingman.PM / Qewler",
    "url": "https://github.com/Qewler"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qewler/wingmanpm-product-designer.git"
  },
  "homepage": "https://github.com/Qewler/wingmanpm-product-designer#readme",
  "bugs": {
    "url": "https://github.com/Qewler/wingmanpm-product-designer/issues"
  },
  "type": "module",
  "bin": {
    "wingmanpm-product-designer": "./bin/wingmanpm-product-designer.mjs",
    "wingman-design": "./skills/wingmanpm-product-designer/bin/wingman-design.mjs"
  },
  "files": [
    "plugin.json",
    ".codex-plugin/",
    ".claude-plugin/",
    ".agents/plugins/",
    "skills/",
    "assets/",
    "bin/",
    "README.md",
    "docs/",
    "PRIVACY.md",
    "TERMS.md",
    "SUPPORT.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "check": "npm run validate:release && npm test",
    "doctor": "node ./skills/wingmanpm-product-designer/bin/wingman-design.mjs --help",
    "test": "node --test tests/*.test.mjs",
    "test:all": "npm run test && npm run validate:release && npm run eval:fixtures",
    "test:fixture:storybook": "npm --prefix fixtures/neutral-saas run build-storybook",
    "test:fixture:browser": "npm --prefix fixtures/neutral-saas run design:test:visual",
    "test:showcase": "npm --prefix showcase run check",
    "test:skills-install": "node ./scripts/smoke-skills-install.mjs",
    "validate:skill": "node ./scripts/validate-skill.mjs ./skills/wingmanpm-product-designer",
    "validate:release": "node ./scripts/validate-release.mjs",
    "eval:fixtures": "node ./evals/run-fixture-evals.mjs",
    "check:share": "node ./scripts/check-share-safety.mjs",
    "check:release": "node ./scripts/check-share-safety.mjs",
    "release:bundle": "npm run validate:release && node ./scripts/build-release.mjs",
    "prepack": "npm run validate:release",
    "eval:record": "node ./evals/record-agent-run.mjs",
    "eval:validate": "node ./evals/validate-agent-result.mjs",
    "bundle:manifest": "node ./scripts/build-bundle-manifest.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent-plugin",
    "agent-skill",
    "codex",
    "claude-code",
    "cursor",
    "product-design",
    "saas",
    "ui-ux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
