{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "light": {
      "brand": { "$value": { "colorSpace": "srgb", "components": [0.2, 0.278, 0.69], "alpha": 1 } },
      "brand-foreground": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1 } },
      "canvas": { "$value": { "colorSpace": "srgb", "components": [0.976, 0.973, 0.961], "alpha": 1 } },
      "surface": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1 } },
      "text": { "$value": { "colorSpace": "srgb", "components": [0.071, 0.078, 0.102], "alpha": 1 } },
      "muted": { "$value": { "colorSpace": "srgb", "components": [0.36, 0.38, 0.42], "alpha": 1 } },
      "border": { "$value": { "colorSpace": "srgb", "components": [0.84, 0.84, 0.81], "alpha": 1 } },
      "status": {
        "success": { "$value": { "colorSpace": "srgb", "components": [0.035, 0.35, 0.18], "alpha": 1 } },
        "warning": { "$value": { "colorSpace": "srgb", "components": [0.54, 0.29, 0], "alpha": 1 } },
        "danger": { "$value": { "colorSpace": "srgb", "components": [0.63, 0.07, 0.11], "alpha": 1 } }
      }
    },
    "dark": {
      "brand": { "$value": { "colorSpace": "srgb", "components": [0.61, 0.67, 1], "alpha": 1 } },
      "brand-foreground": { "$value": { "colorSpace": "srgb", "components": [0.047, 0.055, 0.075], "alpha": 1 } },
      "canvas": { "$value": { "colorSpace": "srgb", "components": [0.047, 0.055, 0.075], "alpha": 1 } },
      "surface": { "$value": { "colorSpace": "srgb", "components": [0.075, 0.086, 0.114], "alpha": 1 } },
      "text": { "$value": { "colorSpace": "srgb", "components": [0.94, 0.94, 0.92], "alpha": 1 } },
      "muted": { "$value": { "colorSpace": "srgb", "components": [0.66, 0.68, 0.72], "alpha": 1 } },
      "border": { "$value": { "colorSpace": "srgb", "components": [0.18, 0.2, 0.25], "alpha": 1 } },
      "status": {
        "success": { "$value": { "colorSpace": "srgb", "components": [0.42, 0.84, 0.59], "alpha": 1 } },
        "warning": { "$value": { "colorSpace": "srgb", "components": [0.96, 0.71, 0.27], "alpha": 1 } },
        "danger": { "$value": { "colorSpace": "srgb", "components": [1, 0.51, 0.55], "alpha": 1 } }
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": { "value": 6, "unit": "px" } },
    "container": { "$value": { "value": 10, "unit": "px" } },
    "focal": { "$value": { "value": 16, "unit": "px" } }
  },
  "duration": {
    "$type": "duration",
    "micro": { "$value": { "value": 140, "unit": "ms" } },
    "structural": { "$value": { "value": 240, "unit": "ms" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" } },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } }
  }
}
