{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Qewler/wingmanpm-product-designer/main/skills/wingmanpm-product-designer/schemas/config.schema.json",
  "title": "WingmanPM Product Designer project configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "systemMode",
    "stack",
    "requiresDarkTheme",
    "scanRoots",
    "viewports"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "systemMode": {
      "enum": [
        "new-system",
        "preserve"
      ]
    },
    "stack": {
      "type": "string",
      "minLength": 1
    },
    "goldenStack": {
      "type": "boolean"
    },
    "requiresDarkTheme": {
      "type": "boolean"
    },
    "aiSurfaces": {
      "type": "boolean"
    },
    "legacyBaseline": {
      "type": "boolean"
    },
    "scanRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!\\.\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "viewports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 320
      },
      "allOf": [
        {
          "contains": {
            "const": 390
          }
        },
        {
          "contains": {
            "const": 768
          }
        },
        {
          "contains": {
            "const": 1280
          }
        },
        {
          "contains": {
            "const": 1440
          }
        }
      ]
    },
    "visualEvidenceMaxAgeDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 180
    },
    "policy": {
      "type": "object",
      "properties": {
        "punctuation": {
          "enum": [
            "off",
            "warn",
            "block"
          ]
        },
        "uniqueHeadings": {
          "enum": [
            "off",
            "warn",
            "block"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
