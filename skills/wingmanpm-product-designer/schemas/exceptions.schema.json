{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Qewler/wingmanpm-product-designer/main/skills/wingmanpm-product-designer/schemas/exceptions.schema.json",
  "title": "WingmanPM Product Designer scoped exceptions",
  "type": "object",
  "required": ["exceptions"],
  "properties": {
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "target", "reason", "approver", "reviewDate"],
        "properties": {
          "ruleId": { "type": "string", "pattern": "^WPD(?:[0-9]{3}|-EXCEPTION)$" },
          "target": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 12 },
          "approver": { "type": "string", "minLength": 2 },
          "reviewDate": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
