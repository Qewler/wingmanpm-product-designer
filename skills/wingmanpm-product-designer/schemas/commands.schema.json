{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Qewler/wingmanpm-product-designer/main/skills/wingmanpm-product-designer/schemas/commands.schema.json",
  "title": "WingmanPM Product Designer command registry",
  "type": "object",
  "required": ["version", "sources", "intents"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "note"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "note": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "intents": {
      "type": "array",
      "minItems": 19,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/intent" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "intent": {
      "type": "object",
      "required": [
        "id",
        "aliases",
        "naturalPhrases",
        "category",
        "summary",
        "defaultLevel",
        "reference",
        "naturalPhrasePicker",
        "protectedScope",
        "verification",
        "mutationPolicy"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "naturalPhrases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "category": {
          "enum": ["transformation", "product-craft", "verification", "saas-pattern", "system"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "defaultLevel": { "enum": ["refine", "elevate", "reimagine"] },
        "reference": { "type": "string", "pattern": "^references/.+\\.md(?:#.+)?$" },
        "naturalPhrasePicker": { "type": "boolean" },
        "protectedScope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "mutationPolicy": { "enum": ["implementation", "read-only-unless-fix"] }
      },
      "additionalProperties": false
    }
  }
}
